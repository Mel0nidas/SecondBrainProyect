# Copiá este archivo a ".env" (sin el ".example") y completá tus valores reales.
# El archivo ".env" nunca se sube a git (está en .gitignore) -- este SÍ se sube,
# como plantilla para saber qué variables hacen falta.

# API key de Anthropic (platform.claude.com -> Settings -> API keys)
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith: activa el envío de trazas y la key para autenticarlas
# (smith.langchain.com -> Settings -> API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...

# Ruta completa a la carpeta de tu bóveda de Obsidian en tu compu
# (Windows: usá la ruta tal cual, con barras invertidas está bien)
RUTA_BOVEDA_OBSIDIAN=D:\Second Brain

# API key de Voyage AI, para los embeddings de la búsqueda semántica
# (dashboard.voyageai.com -> API Keys). Tiene tier gratuito.
VOYAGE_API_KEY=pa-...

# Carpeta donde vive el índice de Chroma (se crea sola si no existe).
# No hace falta que esté dentro de la bóveda de Obsidian.
RUTA_INDICE_CHROMA=D:\Second Brain Chroma Index

# API key de Groq, para transcribir las notas de voz de Telegram
# (console.groq.com -> API Keys). Tier gratuito, sin tarjeta.
GROQ_API_KEY=gsk_...

# Token del bot de Telegram (hablale a @BotFather en Telegram -> /newbot).
TELEGRAM_BOT_TOKEN=123456:ABC-...

# Un secreto inventado por vos (cualquier texto largo random). Se lo
# pasás a Telegram al registrar el webhook, y Telegram te lo devuelve
# en cada pedido -- así confirmás que el pedido vino de Telegram y no
# de cualquiera que le pegue a tu URL.
TELEGRAM_WEBHOOK_SECRET=inventate-algo-largo-y-random-aca

# El chat_id de TU chat con el bot (ningún otro remitente es atendido).
# Para conseguirlo: mandale cualquier mensaje al bot y fijate en
# api.telegram.org/bot<TU_TOKEN>/getUpdates -> ahí aparece tu chat_id.
TELEGRAM_CHAT_ID_AUTORIZADO=123456789

# Archivo donde el grafo guarda su progreso para poder pausarse y
# seguir despues (mecanismo de confirmación por Telegram, Fase 5). Se
# crea solo, no hace falta tocarlo.
RUTA_CHECKPOINTS_SQLITE=grafo_checkpoints.sqlite
